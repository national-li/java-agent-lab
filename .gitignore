# ---------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven Wrapper 的下载产物
.mvn/wrapper/maven-wrapper.jar

# ---------------------------------------------------------------
# IDE
# ---------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------
# 敏感信息 —— 最重要的一段，别删
# ---------------------------------------------------------------
# ⚠️ 规则原则：精确锚定，不用宽泛通配
#    （宽泛通配会误伤 *.example.yml 模板文件，导致别人 clone 后没有配置说明）
#
# 本地配置：敏感项只放这些文件，绝不提交
**/application-local.yml
**/application-local.properties
**/application-dev.yml
**/application-dev.properties
**/application-prod.yml
**/application-prod.properties
**/application-secret.yml
**/application-secret.properties

# 环境变量文件
.env
.env.local
.env.dev
.env.prod

# 证书 / 密钥
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa*

# ⚠️ 例外必须写在排除规则【之后】（Git 按顺序处理，后面的覆盖前面的）
#    这些是"给人看的模板"，必须能提交，否则别人 clone 后不知道要配什么
!**/*.example.yml
!**/*.example.properties
!**/*.sample.yml
!**/*.template.yml
!.env.example

# ---------------------------------------------------------------
# Docker 数据卷（数据在命名卷里，但防止有人挂到本地目录）
# ---------------------------------------------------------------
pgdata/
redisdata/
volumes/

# ---------------------------------------------------------------
# 日志
# ---------------------------------------------------------------
logs/
*.log
log/

# ---------------------------------------------------------------
# 临时测试 payload / 脚本（curl 用的 JSON body 等）
# ---------------------------------------------------------------
_payload*.json
_payload*.txt
*.http
_tmp/
tmp/
scratch/

# ---------------------------------------------------------------
# 上传的文档（W4 的 RAG 测试文件，别提交进仓库）
# ---------------------------------------------------------------
uploads/
data/documents/
*.pdf

# ---------------------------------------------------------------
# Python 原型（W5 的 python-proto）
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------
# 系统文件
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# 其他
# ---------------------------------------------------------------
*.tmp
*.bak
*.orig

# ---------------------------------------------------------------
# ⚠️ 必须在最后：模板文件例外（防上方任何规则误伤）
#    Git 按顺序处理，最后出现的规则优先级最高
# ---------------------------------------------------------------
!*.example.yml
!*.example.properties
!*.sample.yml
!*.template.yml
!.env.example

